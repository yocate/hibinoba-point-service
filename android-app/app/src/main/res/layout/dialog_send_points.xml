<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="だれにおくる？"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">
        
        <Spinner
            android:id="@+id/spinnerReceiverDialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"/>
            
        <ImageButton
            android:id="@+id/btnScanQr"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@color/brand_primary"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="いくらおくる？"
        android:textColor="@color/text_secondary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etAmountDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="0"
        android:gravity="center"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:background="@android:color/transparent"
        android:layout_marginBottom="16dp"/>
        
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnAdd100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+100"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/brand_primary"
            app:strokeColor="@color/brand_primary"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAdd500"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+500"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/brand_primary"
            app:strokeColor="@color/brand_primary"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAdd1000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1000"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/brand_primary"
            app:strokeColor="@color/brand_primary"/>
    </LinearLayout>
    
    <Button
        android:id="@+id/btnClearAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ぜんぶけす"
        android:textColor="@color/danger"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCancelDialog"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="やめる"
            android:textColor="@color/text_secondary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSendDialog"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="おくる"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/coin_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
