<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="送る相手を選ぶ"
        android:textColor="@color/text_grey"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerReceiverDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ポイント数"
        android:textColor="@color/text_grey"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etAmountDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="0"
        android:gravity="center"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:background="@android:color/transparent"
        android:layout_marginBottom="16dp"/>
        
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnAdd100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+100"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAdd500"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+500"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAdd1000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1000"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>
    
    <Button
        android:id="@+id/btnClearAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="クリア"
        android:textColor="@color/red_stat"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCancelDialog"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="キャンセル"
            android:textColor="#757575"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSendDialog"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="送る"
            android:textColor="@android:color/white"
            android:backgroundTint="#D50000"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
